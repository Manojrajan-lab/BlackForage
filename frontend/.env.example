# Safe, non-secret frontend configuration only. Never put the admin API key here:
# anything prefixed VITE_ is bundled into public JavaScript.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Must match the node's BLOCKFORGE_NETWORK: dev | testnet | mainnet
VITE_NETWORK=dev
VITE_REQUEST_TIMEOUT_MS=10000
VITE_POLL_INTERVAL_MS=5000
