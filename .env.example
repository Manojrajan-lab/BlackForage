# Copy to .env and adjust. All variables use the BLOCKFORGE_ prefix.
BLOCKFORGE_NETWORK=dev
BLOCKFORGE_DATA_DIR=./data

BLOCKFORGE_API_HOST=127.0.0.1
BLOCKFORGE_API_PORT=8000
# Required (16+ chars) to enable mining/peer/raw-block endpoints. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BLOCKFORGE_API_KEY=
BLOCKFORGE_CORS_ORIGINS=http://localhost:5173
BLOCKFORGE_RATE_LIMIT_PER_MINUTE=120
BLOCKFORGE_TX_RATE_LIMIT_PER_MINUTE=30

BLOCKFORGE_P2P_ENABLED=true
BLOCKFORGE_P2P_HOST=0.0.0.0
BLOCKFORGE_P2P_PORT=9333
BLOCKFORGE_SEEDS=
BLOCKFORGE_ALLOW_PRIVATE_PEERS=false

BLOCKFORGE_MINE=false
BLOCKFORGE_MINER_ADDRESS=

BLOCKFORGE_LOG_LEVEL=INFO
BLOCKFORGE_LOG_JSON=false